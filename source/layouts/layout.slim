doctype html
html lang='ja'
  head
    meta charset='utf-8'
    meta content='IE=edge' http-equiv='X-UA-Compatible'
    meta content='width=device-width, initial-scale=1' name='viewport'

    - site_title = current_page.data.title || 'designgineer.io'
    title= site_title

    meta content=(current_page.data.description || 'デザインジニア / designgineer.io のポートフォリオサイト。Web制作・UI実装・フロントエンド開発。') name='description'
    meta content='designgineer,デザインジニア,frontend,web design,portfolio' name='keywords'

    meta content=site_title property='og:title'
    meta content=(current_page.data.description || 'デザインジニア / designgineer.io のポートフォリオサイト。') property='og:description'
    meta content='website' property='og:type'
    meta content='https://designgineer.io/' property='og:url'
    meta content='summary_large_image' name='twitter:card'

    link href='https://designgineer.io/' rel='canonical'

    = stylesheet_link_tag 'normalize', 'all'
    = javascript_include_tag 'all'
  body
    == yield
